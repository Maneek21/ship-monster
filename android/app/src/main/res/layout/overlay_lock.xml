<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lock_bg"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="48dp"
            android:paddingEnd="28dp"
            android:paddingBottom="48dp">

            <ImageView
                android:id="@+id/lock_pet"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="@string/pet"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/lock_title"
                android:textColor="@color/on_monster"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/on_monster"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lock_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/amber"
                android:textSize="16sp" />

            <Button
                android:id="@+id/lock_home"
                style="@style/Btn.Light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/lock_home" />

            <Button
                android:id="@+id/lock_check"
                style="@style/Btn.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lock_check" />

            <TextView
                android:id="@+id/lock_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/on_monster_soft"
                android:textSize="13sp" />

            <Button
                android:id="@+id/lock_mercy"
                style="@style/Btn.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/btn_mercy" />

            <TextView
                android:id="@+id/lock_fine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/on_monster_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
