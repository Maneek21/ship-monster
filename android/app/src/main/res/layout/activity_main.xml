<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/main_pet"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/pet"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/main_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/main_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAllCaps="true"
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/main_belly"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/belly"
            android:max="100" />

        <TextView
            android:id="@+id/main_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="monospace"
            android:text="@string/test_heading"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/test_note"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_commit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_commit" />

        <Button
            android:id="@+id/btn_merge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_merge" />

        <Button
            android:id="@+id/btn_skip6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_skip6" />

        <Button
            android:id="@+id/btn_skip24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_skip24" />

        <Button
            android:id="@+id/btn_mercy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_mercy" />

        <Button
            android:id="@+id/btn_hatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_hatch" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_reset" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="monospace"
            android:text="@string/graveyard"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/main_graves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/graveyard_empty"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
