<?xml version="1.0" encoding="utf-8"?>
<!-- Only the game itself is backed up. Settings hold the GitHub token and stay on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="game.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="game.xml" />
    </device-transfer>
</data-extraction-rules>
