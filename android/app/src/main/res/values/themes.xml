<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShipMonster" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/shell</item>
        <item name="android:colorAccent">@color/shell</item>
        <item name="android:windowBackground">@color/shell</item>
        <item name="android:statusBarColor">@color/shell</item>
        <item name="android:navigationBarColor">@color/shell</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Title">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/print</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Heading">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Lcd">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/lcd_ink</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_dark</item>
        <item name="android:textColor">@color/print</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Light">
        <item name="android:background">@drawable/btn_light</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Btn.Outline">
        <item name="android:background">@drawable/btn_outline</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
